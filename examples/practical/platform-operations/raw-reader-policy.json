{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow", "Action": "s3:ListBucket",
    "Resource": "arn:aws:s3:::REPLACE_BUCKET",
    "Condition": {"StringLike": {
      "s3:prefix": ["raw/meter", "raw/meter/*"]
    }}
  }, {
    "Effect": "Allow", "Action": "s3:GetObject",
    "Resource": "arn:aws:s3:::REPLACE_BUCKET/raw/meter/*"
  }]
}
